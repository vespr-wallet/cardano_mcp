{
  "name": "@vespr/cardano-mcp",
  "version": "0.1.1",
  "description": "MCP server for Cardano wallet operations via VESPR",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "cardano-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=12.2.2"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "npm run format:check && tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "tsc --watch",
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "stress-test": "CARDANO_MCP_LOG_LEVEL=silent npx tsx scripts/stress-test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
